NODE_ENV=development
PORT=5000

# ⚠️ Update these with your MySQL credentials
DB_HOST=localhost
DB_PORT=3306
DB_USER=xenotrack_user
DB_PASSWORD=xenotrack_pass
DB_NAME=xenotrack

# ⚠️ Change these in production - must be long random strings
JWT_SECRET=xenotrack_dev_jwt_secret_change_in_production_abcde12345
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=xenotrack_dev_refresh_secret_change_also_xyz98765
JWT_REFRESH_EXPIRES_IN=7d

FRONTEND_URL=http://localhost:3000

UPLOAD_DIR=uploads
MAX_FILE_SIZE=5242880
