NODE_ENV=development
PORT=5000

# Supabase PostgreSQL Configuration
POSTGRES_HOST=aws-0-ap-south-1.pooler.supabase.com
POSTGRES_PORT=6543
POSTGRES_USER=postgres.bniccyxjrasdcnqdnkqt
POSTGRES_PASSWORD=your_supabase_password
POSTGRES_DATABASE=postgres
POSTGRES_URL=postgres://user:pass@host:6543/postgres

# JWT
JWT_SECRET=change_this_to_a_very_long_random_secret_string_32chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change_this_refresh_secret_also_32chars_minimum
JWT_REFRESH_EXPIRES_IN=7d

# CORS
FRONTEND_URL=http://localhost:3000

# File uploads
UPLOAD_DIR=uploads
MAX_FILE_SIZE=5242880
